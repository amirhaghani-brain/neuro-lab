/* Neuro-Lab Modern Terminal Styling */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

Header {
    background: #161b22;
    color: #58a6ff;
    dock: top;
    height: 1;
}

Footer {
    background: #161b22;
    color: #8b949e;
    dock: bottom;
    height: 1;
}

/* Main Dashboard Layout */
#main-container {
    layout: horizontal;
    width: 100%;
    height: 100%;
    padding: 1;
}

#left-panel {
    width: 48;
    height: 100%;
    margin-right: 1;
    layout: vertical;
}

#right-panel {
    width: 1fr;
    height: 100%;
    layout: vertical;
}

/* Widgets */
.panel-card {
    background: #161b22;
    border: round #30363d;
    padding: 1;
    margin-bottom: 1;
}

.panel-card:focus-within {
    border: round #58a6ff;
}

#brain-widget {
    height: auto;
    max-height: 22;
    background: #161b22;
    border: round #8957e5;
    padding: 0 1;
    margin-bottom: 1;
    content-align: center middle;
}

#telemetry-widget {
    height: auto;
    background: #161b22;
    border: round #238636;
    padding: 1;
    margin-bottom: 1;
}

#daily-theory-widget {
    height: auto;
    background: #161b22;
    border: round #d29922;
    padding: 1;
}

/* Tool Hub Section */
#tool-hub-header {
    height: 3;
    padding: 0 1;
    background: #161b22;
    border: round #30363d;
    margin-bottom: 1;
    content-align: left middle;
}

#tools-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
    height: 1fr;
    margin-bottom: 1;
}

/* Tool Cards */
.tool-card {
    height: 100%;
    min-height: 7;
    background: #161b22;
    border: round #30363d;
    padding: 1;
    transition: background 150ms, border 150ms;
}

.tool-card:hover {
    background: #1f242c;
    border: round #58a6ff;
}

.tool-card:focus {
    background: #21262d;
    border: round #bc8cff;
}

.tool-card .tool-title {
    text-style: bold;
    color: #58a6ff;
}

.tool-card .tool-desc {
    color: #8b949e;
    margin-top: 1;
}

.tool-card .tool-meta {
    color: #3fb950;
    margin-top: 1;
}

/* Bottom Bar */
#bottom-actions {
    height: 3;
    layout: horizontal;
    align: right middle;
}

/* Modals */
ModalScreen {
    align: center middle;
    background: rgba(13, 17, 23, 0.85);
}

.modal-dialog {
    width: 65;
    height: auto;
    max-height: 80%;
    background: #161b22;
    border: heavy #58a6ff;
    padding: 1 2;
}

.modal-title {
    text-style: bold;
    color: #58a6ff;
    margin-bottom: 1;
    text-align: center;
}

.modal-buttons {
    layout: horizontal;
    align: center middle;
    margin-top: 1;
    height: 3;
}

.modal-buttons Button {
    margin: 0 1;
}

/* Doctor Screen */
#doctor-container {
    width: 90%;
    height: 85%;
    background: #161b22;
    border: heavy #8957e5;
    padding: 1 2;
}

#doctor-table {
    height: 1fr;
    margin: 1 0;
}
